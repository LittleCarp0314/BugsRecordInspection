{
  "manifest_version": 3,
  "name": "缺陷记录规范检测",
  "version": "1.0",
  "description": "通过连接大模型和输入的缺陷记录规则，判断当前Jira界面记录的缺陷是否规范。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/*", "*://*/jira/*"],
      "js": ["content_script.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
